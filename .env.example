# Copy to .env for local development (the server reads these at startup).

# Code the admin uses to sign in at /admin. Change this before deploying.
ADMIN_CODE=ADMIN-2026

# Where db.json and uploaded photos are written. On Railway, attach a Volume
# and set this to its mount path (e.g. /data) so entries survive redeploys.
DATA_DIR=./data

# Port the server listens on. Railway sets PORT automatically.
PORT=3000

# Optional: comma-separated origins allowed to embed the entry form in an
# iframe. Leave blank to allow any origin (fine for a prototype).
EMBED_ORIGINS=
